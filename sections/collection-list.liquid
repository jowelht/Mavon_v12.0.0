{% liquid
  assign theme_rtl = false
  if settings.enable_rtl and settings.langauges_rtl == blank
    assign theme_rtl = true
  endif

  if settings.enable_rtl and settings.langauges_rtl != blank
    assign rtl_languages = settings.langauges_rtl | split: ','
    for language in rtl_languages
      if language == request.locale.iso_code
        assign theme_rtl = true
      endif
    endfor
  endif
%}

{{ 'section-collection-list.css' | asset_url | stylesheet_tag }}
{{ 'section-slider-button-controls.css' | asset_url | stylesheet_tag }}

<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
   .section-{{ section.id }}-padding {
     padding-top: {{ section.settings.mobile_padding_top }}px;
     padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
     --padding-top: {{ section.settings.mobile_padding_top }}px;
   }

   @media screen and (min-width: 750px) {
     .section-{{ section.id }}-padding {
       padding-top: {{ section.settings.padding_top }}px;
       padding-bottom: {{ section.settings.padding_bottom }}px;
       --padding-top: {{ section.settings.padding_top }}px;
     }
   }
    #MainContent > :first-child .section--top-space-{{ section.id }} {
     padding-top: calc(var(--header-height) * var(--transparent-header-show) + var(--padding-top));
   }
   #section__{{ section.id }}.collection__list--slider.slider--controls--button{
      --slider-button-background: {{ section.settings.button_background }};
      --slider-button-color: {{ section.settings.button_text_color }};
   }
   {% liquid
      assign media_query = settings.container_lg_width | plus: 130
    %}
   {% if section.settings.full_width %}
    @media only screen and (min-width: 750px){
      {% if theme_rtl %}
      #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-prev.product__slider--button {
          right: 0;
          left: auto;
      }
      #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-next.product__slider--button {
          left: 0;
          right: auto;
      }
     {% else %}
     #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-prev.product__slider--button {
          left: 0;
      }
      #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-next.product__slider--button {
          right: 0;
      }
     {% endif %}
    }
   {% else %}
    @media only screen and (min-width: {{ media_query }}px){
      {% if theme_rtl %}
      #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-prev.product__slider--button {
          right: -6.5rem;
          left: auto;
      }
      #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-next.product__slider--button {
          left: -6.5rem;
          right: auto;
      }
     {% else %}
     #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-prev.product__slider--button {
          left: -6.5rem;
      }
      #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-next.product__slider--button {
          right: -6.5rem;
      }
     {% endif %}
    }
   {% endif %}
    {%- if section.settings.custom_colors_navigation -%}
    #section__{{ section.id }}.collection__list--slider.slider--controls--button{
       --color-foreground: {{ section.settings.nav_foreground.red }}, {{ section.settings.nav_foreground.green }}, {{ section.settings.nav_foreground.blue }};
       --color-background: {{ section.settings.nav_background.red }}, {{ section.settings.nav_background.green }}, {{ section.settings.nav_background.blue }};
    }
    #section__{{ section.id }}.collection__list--slider.slider--controls--button .product__slider--button:not(.button--no_border){
      background: rgba(var(--color-background));
    }
   #section__{{ section.id }}.collection__list--slider.slider--controls--button .product__slider--button:not(.button--no_border):hover, #section__{{ section.id }}.collection__list--slider.slider--controls--button .product__slider--button:not(.button--no_border):focus-visible {
     background: var(--slider-button-background);
   }
   {%- endif -%}
  {% if section.settings.full_width %}
   @media only screen and (min-width: 1600px){
     .container-fluid.page--width-{{ section.id }}{
       --offset-fluid: 3rem;
     }
   }
   @media only screen and (max-width: 1599px){
     .container-fluid.page--width-{{ section.id }}{
       --offset-fluid: 1.5rem;
     }
   }
   {% endif %}
{%- endstyle -%}

{%- liquid
  if section.settings.layout == 'masonry'
    assign columns = section.blocks.size
    if columns > 3
      assign columns = 3
    endif
  else
    assign columns = section.settings.column
  endif

  if section.settings.layout == 'standard'
    assign column_set = section.settings.column
    case column_set
      when '1'
        if section.settings.products_show_on_sm == '2'
          assign column_class_standard = 'col-6 col-md-12'
        else
          assign column_class_standard = 'col-12'
        endif
      when '2'
        if section.settings.products_show_on_sm == '2'
          assign column_class_standard = 'col-md-6 col-sm-6 col-6'
        else
          assign column_class_standard = 'col-md-6 col-sm-6 col-12'
        endif
      when '3'
        if section.settings.products_show_on_sm == '2'
          assign column_class_standard = 'col-md-4 col-sm-6 col-6'
        else
          assign column_class_standard = 'col-md-4 col-sm-6 col-12'
        endif
      when '4'
        if section.settings.products_show_on_sm == '2'
          assign column_class_standard = 'col-md-3 col-sm-6 col-6'
        else
          assign column_class_standard = 'col-md-3 col-sm-6 col-12'
        endif

      else
        assign column_class_standard = 'col'
    endcase
  endif

  if section.settings.layout == 'slider'
    assign slider_enable = true
  endif

  if slider_enable
    assign show_pagination = section.settings.show_pagination
    assign show_navigation = section.settings.show_navigation

    assign product_show_xl = section.settings.column
    assign product_show_sm = section.settings.products_show_on_sm
    assign slide_auto_play = section.settings.auto_rotate
    assign autoplay_time = section.settings.autoplay_time

    assign max_proudct_show_first_view = section.settings.column | plus: 0
  endif

  # View all button
  assign more_in_collection = false
  if section.settings.show_view_all and section.blocks.size < collections.size
    assign more_in_collection = true
  endif

  if section.settings.button_style == 'primary'
    assign button_class = ''
  else
    assign button_class = 'button--secondary'
  endif
-%}

{%- capture slider_wrapper -%}
{%- if slider_enable -%}
productSlider swiper
{%- else -%}
row {% if section.settings.column == "5" %} row-cols-xl-5 row-cols-lg-4 row-cols-md-3 row-cols-sm-{{ section.settings.products_show_on_sm }} row-cols-{{ section.settings.products_show_on_sm }} {% endif %} {% if section.settings.column == "6" %} row-cols-xl-6 row-cols-lg-5 row-cols-md-3 row-cols-sm-{{ section.settings.products_show_on_sm }} row-cols-{{ section.settings.products_show_on_sm }} {% endif %}
{%- endif -%}
{%- endcapture -%}

<div
  class="collection-list-wrapper section--top-space-{{ section.id }} section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} gradient"
  data-section-id="{{ section.id }}"
  data-section-type="product-slider"
  data-slider-enable="{{ slider_enable }}"
  {% if slider_enable %}
    data-show-pagination="{{ section.settings.show_pagination }}"
    data-pagination-type="{{ section.settings.pagination_type }}"
    data-show-mobile="{{ product_show_sm }}"
    data-show-tablet="3"
    data-show-extra-large="{{ product_show_xl }}"
    data-autoplay="{{ slide_auto_play }}"
    data-autoplay-time="{{ autoplay_time }}000"
    data-slider-loop="{%- if section.blocks.size > max_proudct_show_first_view -%}true {%- else -%} false {%- endif -%}"
  {% endif %}
>
  <div class="{% if section.settings.full_width %}container-fluid page--width-{{ section.id }}{% else %}container{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    {% liquid
      assign top_view_all_button = false
      if section.settings.view_all_button_position == 'top' and more_in_collection and section.settings.button_label != blank
        assign top_view_all_button = true
      endif

      assign slider_navigation_top_place = false
      if slider_enable and section.settings.navigation_position == 'top'
        assign slider_navigation_top_place = true
      endif
    %}

    {%- if slider_navigation_top_place or top_view_all_button -%}
      <div
        class="slider__heading--wrapper d-flex align-items-end {% if section.settings.heading != blank or section.settings.subtitle != blank  %}mb-50 {% endif %}"
      >
    {% endif %}

    <div class="section-heading text-{{ section.settings.alignment }} mobile-text-{{ section.settings.mobile_alignment }}  {% if slider_navigation_top_place or top_view_all_button %} flex-grow-1 {% else %} {% if section.settings.heading != blank or section.settings.subtitle != blank  %}mb-50 {% endif %} {% endif %}">
      <h2 class="section-heading__title {{ section.settings.heading_size }} rte gradient--title">
        {{-
          section.settings.heading
          | replace: 'p>', 'span>'
          | replace: 'h1>', 'span>'
          | replace: 'h3>', 'span>'
          | replace: 'h4>', 'span>'
          | replace: 'h5>', 'span>'
          | replace: 'h6>', 'span>'
        -}}
      </h2>
      {% if section.settings.subtitle != blank %}
        <span class="section-heading__sub_title">{{- section.settings.subtitle -}}</span>
      {% endif %}
    </div>

    {%- if slider_navigation_top_place and top_view_all_button -%}
      <div class="section--top-navigation-with-button d-flex align-items-center">
    {% endif %}

    {%- if slider_navigation_top_place -%}
      <div
        class="collection__list--slider navigation--button-controls-{{ section.settings.navigation_button_style }} slider--controls--button d-flex align-items-center {% if slider_navigation_top_place and top_view_all_button %}navigation--button-no-space{% endif %}"
        id="section__{{ section.id }}"
        {% if section.settings.navigation_button_style == 'round' %}
          style="--slider-button-radius: {{ section.settings.slider_button_radius }}%;"
        {% endif %}
      >
        {%- if show_navigation -%}
          <div class="swiper-button-prev product__slider--button navigation--icon-{{ section.settings.navigation_icon_style }} button--{{ section.settings.navigation_button_style }}">
            {% if section.settings.navigation_icon_style == 'chevron' %}
              {% render 'slider-left-arrow-icon' %}
            {% elsif section.settings.navigation_icon_style == 'small_arrow' %}
              {% render 'slider-arrow-icons', icon: 'left' %}
            {% else %}
              {% render 'slider-long-arrow-icons', icon: 'left' %}
            {% endif %}
          </div>
        {%- endif -%}
        {%- if show_pagination and section.settings.pagination_type != 'progress-bar' -%}
          <div class="swiper-pagination product__slider--pagination"></div>
        {%- endif -%}
        {%- if show_navigation -%}
          <div class="swiper-button-next product__slider--button navigation--icon-{{ section.settings.navigation_icon_style }} button--{{ section.settings.navigation_button_style }}">
            {% if section.settings.navigation_icon_style == 'chevron' %}
              {% render 'slider-right-arrow-icon' %}
            {% elsif section.settings.navigation_icon_style == 'small_arrow' %}
              {% render 'slider-arrow-icons', icon: 'right' %}
            {% else %}
              {% render 'slider-long-arrow-icons', icon: 'right' %}
            {% endif %}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if top_view_all_button -%}
      <div class="view--all-button-wrapper">
        <a
          href="{{ routes.collections_url }}"
          class="button button--{{ section.settings.button_size }} {{ button_class }}"
        >
          {{- section.settings.button_label -}}
        </a>
      </div>
    {%- endif -%}

    {%- if slider_navigation_top_place and top_view_all_button -%}
      </div>
    {% endif %}

    {%- if slider_navigation_top_place or top_view_all_button -%}
      </div>
    {% endif %}

    <div class="collection--list-slider"
    {% if section.settings.image_round_corner %} 
      style="
     {% if section.settings.corner_radius_type == 'px' %}
      --rounded-image: {{ section.settings.corner_radius }}px;
      {% else %}
        --rounded-image: {{ section.settings.corner_radius_percentage }}%;
      {% endif %}
      "
    {% endif %}
    >
      <div class="collection-list {{ slider_wrapper }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if slider_enable -%}<div class="swiper-wrapper">{% endif %}
        {%- for block in section.blocks -%}
          {% capture placeholder_index %}{% cycle 1, 2, 3, 4 %}{% endcapture %}
          {%- liquid
            if section.settings.layout == 'masonry'
              if forloop.index > 2
                if section.settings.products_show_on_sm == '2'
                  assign column_class = 'col-md-4 col-sm-6 col-6'
                else
                  assign column_class = 'col-md-4 col-sm-6 col-12'
                endif
              else
                if section.settings.products_show_on_sm == '2'
                  assign column_class = 'col-md-6 col-sm-6 col-6'
                else
                  assign column_class = 'col-md-6 col-sm-6 col-12'
                endif
              endif
            endif
          -%}
          <div
            class="collection-list__item {% if slider_enable %} swiper-slide {% else %} {{ column_class }} {{ column_class_standard }} mb-30{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            {%- render 'collection-card',
              collection: block.settings.collection,
              custom_image: block.settings.image,
              product_count: section.settings.product_count,
              columns: columns,
              round_image: section.settings.image_round_corner,
              image_ratio: section.settings.image_ratio,
              content_position: section.settings.show_content_below_image,
              title_design: section.settings.title_design,
              button_size: section.settings.card_button_size,
              button_type: section.settings.card_button_style,
              use_custom_color: block.settings.use_custom_color,
              button_foreground_color: block.settings.button_foreground_color,
              button_background_color: block.settings.button_background_color,
              show_content_below_image_mobile: section.settings.show_content_below_image_mobile,
              title_size: section.settings.card_title_size,
              use_arrow_icon: section.settings.use_arrow_icon,
              icon_type: section.settings.icon_type,
              use_card_color: block.settings.use_card_color,
              card_color_scheme: block.settings.card_color_scheme,
              placeholder_index: placeholder_index
            -%}
          </div>
        {%- endfor -%}

        {%- if slider_enable -%}
          </div>
        {%- endif -%}
      </div>

      {% liquid
        assign navigation_bottom_place = false
        if section.settings.navigation_position == 'middle' or section.settings.navigation_position == 'bottom'
          if show_navigation
            assign navigation_bottom_place = true
          endif
        endif

        assign navigation_div = false
        if show_navigation or show_pagination
          assign navigation_div = true
        endif

        if show_pagination and show_navigation == false
          assign navigation_bottom_place = true
        endif

        assign is_not_pagination_progressbar = false
        assign is_pagination_progressbar = false
        if show_pagination and section.settings.pagination_type != 'progress-bar'
          assign is_not_pagination_progressbar = true
        elsif show_pagination and section.settings.pagination_type == 'progress-bar'
          assign is_pagination_progressbar = true
        endif

        assign is_nav_with_progresbar = false
        if show_navigation and section.settings.navigation_position == 'bottom'
          assign is_nav_with_progresbar = true
        endif

        assign is_nav_with_progressbar_design = false
        if is_pagination_progressbar and is_nav_with_progresbar
          assign is_nav_with_progressbar_design = true
        endif
      %}

      {%- if slider_enable and navigation_div and navigation_bottom_place -%}
        <div
          class="
            collection__list--slider slider--controls--button
             {% if section.settings.navigation_position == 'middle' %}slider--navgaition-button-absolute{% endif %}
             {% if navigation_div or is_not_pagination_progressbar %} slideshow-controls-bottom-margin{% endif %}
            {% if show_navigation and section.settings.navigation_position == 'bottom' %}d-flex align-items-center justify-content-center  {% if show_pagination and is_nav_with_progressbar_design == false %}slider--pagination-width-auto{% endif %}{% endif %}
          "
          id="section__{{ section.id }}"
          {% if section.settings.navigation_button_style == 'round' %}
            style="--slider-button-radius: {{ section.settings.slider_button_radius }}%;"
          {% endif %}
        >
          {%- if show_navigation -%}
            <div class="swiper-button-prev navigation--icon-{{ section.settings.navigation_icon_style }} product__slider--button button--{{ section.settings.navigation_button_style }}">
              {% if section.settings.navigation_icon_style == 'chevron' %}
                {% render 'slider-left-arrow-icon' %}
              {% elsif section.settings.navigation_icon_style == 'small_arrow' %}
                {% render 'slider-arrow-icons', icon: 'left' %}
              {% else %}
                {% render 'slider-long-arrow-icons', icon: 'left' %}
              {% endif %}
            </div>
          {%- endif -%}
          {%- if is_not_pagination_progressbar or is_nav_with_progressbar_design -%}
            <div
              class="swiper-pagination product__slider--pagination {% if is_nav_with_progressbar_design %}nav-button-with-progressbar pagination--progressbar{% endif %}"
            ></div>
          {%- endif -%}
          {%- if show_navigation -%}
            <div class="swiper-button-next navigation--icon-{{ section.settings.navigation_icon_style }} product__slider--button button--{{ section.settings.navigation_button_style }}">
              {% if section.settings.navigation_icon_style == 'chevron' %}
                {% render 'slider-right-arrow-icon' %}
              {% elsif section.settings.navigation_icon_style == 'small_arrow' %}
                {% render 'slider-arrow-icons', icon: 'right' %}
              {% else %}
                {% render 'slider-long-arrow-icons', icon: 'right' %}
              {% endif %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- if more_in_collection and section.settings.view_all_button_position == 'bottom' -%}
      <div class="center mt-50">
        <a
          href="{{ routes.collections_url }}"
          class="button button--{{ section.settings.button_size }} {{ button_class }}"
        >
          {{- section.settings.button_label -}}
        </a>
      </div>
    {%- endif -%}
    {%- if is_pagination_progressbar and is_nav_with_progressbar_design == false -%}
      <div class="swiper-pagination product__slider--pagination pagination--progressbar"></div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection-list.name",
  "disabled_on": {
      "groups": ["header","footer"]
  },
  "tag": "section",
  "class": "spaced-section collection-list-section",
  "max_blocks": 15,
  "settings": [
    {
        "type": "richtext",
        "id": "heading",
        "default": "<p>Shop by collection</p>",
        "label": "t:sections.collection-list.settings.title.label",
        "info": "Use bold style to highlight text."
    },
	{
    "type": "select",
    "id": "heading_size",
    "options": [
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__h0.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__h1.label"
        },
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__h2.label"
        }
     ],
     "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "default": "Share information about your brand with your customers.",
      "label": "Subheading"
    },
	{
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left",
      "label": "Heading alignment"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        {
          "value": "standard",
          "label": "Grid"
        },
        {
          "value": "masonry",
          "label": "Collage"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "slider",
      "label": "Layout"
    },
	{
      "type": "select",
      "id": "column",
      "options": [
		{
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
		{
          "value": "4",
          "label": "4"
        },
		{
          "value": "5",
          "label": "5"
        },
        {
          "value": "6",
          "label": "6"
        }
      ],
      "default": "4",
      "label": "Number of columns on desktop",
	  "info": "Except for the collage layout, Works on all other layouts"
    },
    {
        "type": "checkbox",
        "id": "full_width",
        "label": "Make section full width on desktop",
        "default": false
      },
    {
      "type": "header",
      "content": "Collection card"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.collection-list.settings.image_ratio.options__1.label"
        },
        {
          "value": "round",
          "label": "t:sections.collection-list.settings.image_ratio.options__2.label"
        },
        {
          "value": "square",
          "label": "t:sections.collection-list.settings.image_ratio.options__3.label"
        },
        {
            "value": "landscape",
            "label": "t:sections.main-collection-product-grid.settings.image_ratio.options__4.label"
          },
        {
          "value": "circle",
          "label": "Circle"
        }
      ],
      "default": "round",
      "label": "t:sections.collection-list.settings.image_ratio.label",
      "info": "t:sections.collection-list.settings.image_ratio.info"
    },
    {
      "type": "checkbox",
      "id": "image_round_corner",
      "default": true,
      "label": "Round the corners of the image"
    },
    {
    "type": "select",
    "id": "corner_radius_type",
    "options": [
        {
          "value": "px",
          "label": "px"
        },
        {
          "value": "percentage",
          "label": "%"
        }
     ],
     "default": "percentage",
      "label": "Radius unit type",
      "visible_if": "{{ section.settings.image_round_corner }}"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Corner radius",
      "default": 10,
      "visible_if": "{{ section.settings.image_round_corner and section.settings.corner_radius_type == 'px' }}"
    },
    {
      "type": "range",
      "id": "corner_radius_percentage",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "%",
      "label": "Corner radius",
      "default": 45,
      "visible_if": "{{ section.settings.image_round_corner and section.settings.corner_radius_type == 'percentage' }}"
    },      
    {
      "type": "checkbox",
      "id": "product_count",
      "default": false,
      "label": "Show product count"
    },
    {
     "type": "checkbox",
     "id": "show_content_below_image",
     "label": "Show content below the images",
     "default": true
     },
    {
     "type": "checkbox",
