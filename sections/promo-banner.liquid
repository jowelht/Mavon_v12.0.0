{{ 'promo-banner.css' | asset_url | stylesheet_tag }}
{%- style -%}
   .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
     --padding-top: {{ section.settings.mobile_padding_top }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      --padding-top: {{ section.settings.padding_top }}px;
    }
  }
  #MainContent > :first-child .section--top-space-{{ section.id }} {
    padding-top: calc(var(--header-height) * var(--transparent-header-show) + var(--padding-top));
  }

  {% if section.settings.custom_colors %}
    .promo--banner-{{ section.id }}{
      --color-foreground: {{ section.settings.foreground.red }}, {{ section.settings.foreground.green }}, {{ section.settings.foreground.blue }};
      --color-background: {{ section.settings.background.red }}, {{ section.settings.background.green }}, {{ section.settings.background.blue }};
    }
  {% endif %}
{%- endstyle -%}
<div class="promo--banner-wrapper section--top-space-{{ section.id }} section-{{ section.id }}-padding"
{% if section.settings.round_corner %} style="--promo-banner-radius: {{ section.settings.corner_radius }}px;"{% endif %}
>
  <div class="container">
    <div class="promo--banner-inner promo--banner-height-{{ section.settings.height }} {% if section.settings.border %}promo--banner-border promo-banner-border-place-{{ section.settings.border_placement }}{% endif %} {% if section.blocks.size == 1 %} not-promo--banner-grid{% endif %} color-{{ section.settings.color_scheme }} {% if section.settings.custom_colors  %} promo--banner-{{ section.id }} {% else %}gradient {% endif %} {% if section.settings.round_corner %} rounded--box{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'text' %}
            <!-- Promo Banner Content -->
            <div
              class="promo--banner-content promo--banner-content-{{ block.settings.content_alignment }}"
              {{ block.shopify_attributes }}
            >
              <div class="promo--banner-content--subheading">{{ block.settings.subheading }}</div>
              <h2 class="promo--banner-content--heading {{ block.settings.heading_size }} mb-0">
                <span class="promo--banner-content--heading">{{ block.settings.heading }}</span>
                <span class="promo--banner-content--heading-sub">{{ block.settings.heading_stroke }}</span>
              </h2>
              {% if block.settings.button_label != blank %}
                <div class="promo--banner-content--button">
                  {% if block.settings.button_link != blank %}
                    <a class="link promo--banner-content--button--link" href="{{ block.settings.button_link }}">
                      {{ block.settings.button_label }}
                    </a>
                  {% else %}
                    <span class="link promo--banner-content--button--link"> {{ block.settings.button_label }} </span>
                  {% endif %}
                </div>
              {% endif %}
            </div>
            <!-- Promo Banner Content ./ -->

          {% when 'image' %}
            <!-- Promo banner media -->
            <div
              class="promo--banner-media-wrapper {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.banner_link != blank and block.settings.image != blank %}
                <a href="{{ block.settings.banner_link }}" class="promo--banner-media-link">
              {% endif %}
              <div
                class="promo--banner-media {% if block.settings.image != blank %}media{% else %} placeholder{% endif %}"
              >
                {%- if block.settings.image != blank -%}
                  {%- capture sizes -%}{% if section.blocks.size == 1  %} (min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 }}px, (min-width: 750px) calc(100vw - 130px) {% else %}(min-width: {{ settings.page_width }}px) {{ settings.page_width | minus: 100 | divided_by: 2 }}px, (min-width: 750px) calc((100vw - 130px) / 2){% endif %}, calc(100vw - 50px){%- endcapture -%}
                  {{
                    block.settings.image
                    | image_url: width: 1500
                    | image_tag:
                      loading: 'lazy',
                      sizes: sizes,
                      widths: '165, 360, 535, 750, 1070, 1500, 1700, 2200, 3000'
                  }}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </div>
              {% if block.settings.banner_link != blank and block.settings.image != blank %}
                </a>
              {% endif %}
            </div>
            <!-- Promo banner media ./ -->
          {%  when 'timer' %}
           <!-- Promo banner media -->
           {% liquid
              assign timer_content_alignment = 'center'
              if block.settings.layout == 'vertical'
                assign timer_content_alignment = block.settings.timer_content_alignment
                assign timer_content_mobile_alignment = block.settings.timer_content_mobile_alignment
              endif
           %}
            <div
              class="promo--banner-timer-wrapper promo--timer-{{ block.settings.layout }}"
              {{ block.shopify_attributes }}
              style="
              --timer-content-alignment: {{ timer_content_alignment }};
              --timer-content-mobile-alignment: {{ timer_content_mobile_alignment }};
              {% if block.settings.layout == 'vertical' %}
              --timer-content-space-between: center;
              {% endif %}
              "
            >
              <div class="promo-banner-timer-content">
                {%- if block.settings.subheading != blank -%}
                <div class="promo-timer-subheading text__secondary">{{ block.settings.subheading }}</div>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                <h2 class="promo-timer-heading {{ block.settings.heading_size }}  storke--title">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="promo-timer-description">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>    
              
              {%- liquid
                assign minutes_padded = block.settings.countdown_minutes | prepend: '00' | slice: -2, 2
                assign seconds_padded = block.settings.countdown_seconds | prepend: '00' | slice: -2, 2
                assign countdown_timer = block.settings.year | append: '-' | append: block.settings.countdown_month | append: '-' | append: block.settings.countdown_days | append: 'T' | append: block.settings.countdown_hours | append: ':' | append: minutes_padded | append: ':' | append: seconds_padded
                assign countdown_timer_convert = countdown_timer | date: '%s'
                assign today_date = 'now' | date: '%s'

                assign timer = false
                if countdown_timer_convert > today_date
                  assign timer = true
                endif

                assign timer_label_letter_case = 'timer--label-' | append: block.settings.timer_text_style
              -%}
              <countdown-timer>
                {% if timer %}
                  <div
                    class="promo-banner-timer {{ timer_label_letter_case }} d-flex"
                    data-countdown="{{ block.settings.year }}-{{ block.settings.countdown_month }}-{{ block.settings.countdown_days }}T{{ block.settings.countdown_hours }}:{{ minutes_padded }}:{{ seconds_padded }}"
                  >
                    <div class="countdown-item Days">
                      <div class="countdown__inner">
                        <span class="countdown__digit">- -</span>
                        <span class="countdown__labels">{{ 'products.product.countdown_timer.days' | t }}</span>
                      </div>
                    </div>
                    <div class="countdown-item Hrs">
                      <div class="countdown__inner">
                        <span class="countdown__digit">- -</span>
                        <span class="countdown__labels">{{ 'products.product.countdown_timer.hours' | t }}</span>
                      </div>
                    </div>
                    <div class="countdown-item Min">
                      <div class="countdown__inner">
                        <span class="countdown__digit">- -</span>
                        <span class="countdown__labels">{{ 'products.product.countdown_timer.minutes' | t }}</span>
                      </div>
                    </div>
                    <div class="countdown-item Sec">
                      <div class="countdown__inner">
                        <span class="countdown__digit">- -</span>
                        <span class="countdown__labels">{{ 'products.product.countdown_timer.seconds' | t }}</span>
                      </div>
                    </div>
                  </div>
                {% else %}
                  <div class="promo-banner-timer {{ timer_label_letter_case }} d-flex">
                    <div class="countdown-item Days">
                      <div class="countdown__inner">
                        <span class="countdown__digit">00</span>
                        <span class="countdown__labels">{{ 'products.product.countdown_timer.days' | t }}</span>
                      </div>
                    </div>
                    <div class="countdown-item Hrs">
                      <div class="countdown__inner">
                        <span class="countdown__digit">00</span>
                        <span class="countdown__labels">{{ 'products.product.countdown_timer.hours' | t }}</span>
                      </div>
                    </div>
                    <div class="countdown-item Min">
                      <div class="countdown__inner">
                        <span class="countdown__digit">00</span>
                        <span class="countdown__labels">{{ 'products.product.countdown_timer.minutes' | t }}</span>
                      </div>
                    </div>
                    <div class="countdown-item Sec">
                      <div class="countdown__inner">
                        <span class="countdown__digit">00</span>
                        <span class="countdown__labels">{{ 'products.product.countdown_timer.seconds' | t }}</span>
                      </div>
                    </div>
                  </div>
                {% endif %}
              </countdown-timer>
          
            {% liquid
              if block.settings.button_type == 'primary'
                assign button_class = 'button--primary'
              else
                assign button_class = 'button--secondary'
              endif
            %}
            {%- if block.settings.button_label != blank -%}
              <div class="promo--timer-button-wrapper">
                <a
                  {% if block.settings.button_link != blank %}
                    href="{{ block.settings.button_link }}"
                  {% endif %}
                  class="button button--{{ block.settings.button_size }} {{ button_class }} {% if block.settings.button_icon %} button--with-icon{% endif %}"
                  {% if block.settings.button_link == blank %}
                    aria-disabled="true"
                  {% endif %}
                >
                  {{ block.settings.button_label | escape }}

                  {% if block.settings.button_icon %}
                    <span class="button--icon button--icon-right"></span>
                  {% endif %}
                </a>
              </div>
            {%- endif -%}
            </div>
            <!-- Promo banner media ./ -->  
        {% endcase %}
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo banner",
  "class": "promo--banner-section",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "checkbox",
      "id": "border",
      "label": "Enable",
      "default": true
    },
    {
      "type": "select",
      "id": "border_placement",
      "options": [
        {
          "value": "inside",
          "label": "Inside"
        },
        {
          "value": "outside",
          "label": "Outside"
        }
      ],
      "default": "inside",
      "label": "Border placement"
    },
    {
      "type": "checkbox",
      "id": "round_corner",
      "default": true,
      "label": "Round the corners of the box"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "label": "Corner radius",
      "default": 10,
      "visible_if": "{{ section.settings.round_corner }}"
    },
    {
      "type": "header",
      "content": "Banner height"
    },
    {
      "type": "select",
      "id": "height",
      "options": [
        {
          "value": "auto",
          "label": "Auto"
        },
        {
          "value": "small",
          "label": "t:sections.image-with-text.settings.height.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.image-with-text.settings.height.options__3.label"
        }
      ],
      "default": "small",
      "label": "t:sections.image-with-text.settings.height.label"
    },
    {
      "type": "header",
      "content": "Section padding"
    },
    {
          "type": "paragraph",
          "content": "Desktop"
        },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 150,
          "step": 5,
          "unit": "px",
          "label": "Padding top",
          "default": 50
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 150,
          "step": 5,
          "unit": "px",
          "label": "Padding bottom",
          "default": 50
