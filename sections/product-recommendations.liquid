{%- style -%}
  .rating {
       display: inline-block;
       margin: 0;
     }

     .product .rating-star {
       --letter-spacing: 0.8;
       --font-size: 1.7;
     }

     .product-grid-item .rating-star {
       --letter-spacing: 0.7;
       --font-size: 1.4;
     }

     .rating-star {
       --percent: calc(
         (
             var(--rating) / var(--rating-max) + var(--rating-decimal) *
               var(--font-size) /
               (var(--rating-max) * (var(--letter-spacing) + var(--font-size)))
           ) * 100%
       );
       letter-spacing: calc(var(--letter-spacing) * 1rem);
       font-size: calc(var(--font-size) * 1rem);
       line-height: 1;
       display: inline-block;
       font-family: Times;
       margin: 0;
     }

     .rating-star::before {
       content: '★★★★★';
       background: linear-gradient(
         90deg,
         var(--color-icon) var(--percent),
         rgba(var(--color-foreground), 0.15) var(--percent)
       );
       -webkit-background-clip: text;
       -webkit-text-fill-color: transparent;
     }

     .rating-text {
       display: none;
     }

     .rating-count {
       display: inline-block;
       margin: 0;
     }

     @media (forced-colors: active) {
       .rating {
         display: none;
       }

       .rating-text {
         display: block;
       }
   }
   .section-{{ section.id }}-padding {
     padding-top: {{ section.settings.mobile_padding_top }}px;
     padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
   }

   @media screen and (min-width: 750px) {
     .section-{{ section.id }}-padding {
       padding-top: {{ section.settings.padding_top }}px;
       padding-bottom: {{ section.settings.padding_bottom }}px;
     }
   }
   #section__{{ section.id }}.collection__list--slider.slider--controls--button{
      --slider-button-background: {{ section.settings.button_background }};
      --slider-button-color: {{ section.settings.button_text_color }};
   }
  {% liquid
     assign media_query = settings.container_lg_width | plus: 130
   %}
   @media only screen and (min-width: {{ media_query }}px){
      {% if theme_rtl %}
     #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-prev.product__slider--button {
         right: -6.5rem;
     }
     #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-next.product__slider--button {
         left: -6.5rem;
     }
     {% else %}
      #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-prev.product__slider--button {
         left: -6.5rem;
     }
     #section__{{ section.id }}.slider--navgaition-button-absolute .swiper-button-next.product__slider--button {
         right: -6.5rem;
     }
    {% endif %}
   }
  {%- if section.settings.custom_colors_navigation -%}
   #section__{{ section.id }}.collection__list--slider.slider--controls--button{
      --color-foreground: {{ section.settings.nav_foreground.red }}, {{ section.settings.nav_foreground.green }}, {{ section.settings.nav_foreground.blue }};
      --color-background: {{ section.settings.nav_background.red }}, {{ section.settings.nav_background.green }}, {{ section.settings.nav_background.blue }};
   }
   #section__{{ section.id }}.collection__list--slider.slider--controls--button .product__slider--button:not(.button--no_border){
     background: rgba(var(--color-background));
   }
  #section__{{ section.id }}.collection__list--slider.slider--controls--button .product__slider--button:not(.button--no_border):hover, #section__{{ section.id }}.collection__list--slider.slider--controls--button .product__slider--button:not(.button--no_border):focus-visible {
    background: var(--slider-button-background);
  }
  {%- endif -%}
{%- endstyle -%}

{%- liquid
  assign product_show_xl = section.settings.products_show_on_xl
  assign product_show_sm = section.settings.products_show_on_sm
  assign slide_auto_play = section.settings.auto_rotate
  assign autoplay_time = section.settings.autoplay_time

  assign slider_enable = section.settings.slider_enable
  assign product_item = 'col mb-30'

  if slider_enable
    assign product_item = 'swiper-slide'
    assign show_pagination = section.settings.show_pagination
    assign show_navigation = section.settings.show_navigation
  endif
-%}

{%- if theme_rtl -%}
  {{ 'product-card-item-rtl.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<div class="section">
  <product-recommendations
    class="product-recommendations"
    data-intent="related"
    data-slider-enable="{{ slider_enable }}"
    {% if slider_enable %}
      data-show-pagination="{{ section.settings.show_pagination }}"
      data-pagination-type="{{ section.settings.pagination_type }}"
      data-show-mobile="{{ product_show_sm }}"
      data-show-extra-large="{{ product_show_xl }}"
      data-autoplay="{{ slide_auto_play }}"
      data-autoplay-time="{{ autoplay_time }}000"
      data-slider-loop="true"
    {% endif %}
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
  >
    {%- capture product_wrapper -%}
  {%- if slider_enable -%}
  productSlider swiper
  {%- else -%}
  row row-cols-xl-{{ product_show_xl }} row-cols-md-{{ product_show_xl }} row-cols-{{ product_show_sm }}
  {%- endif -%}
  {%- endcapture -%}
    <div class="container no-js-inline section-{{ section.id }}-padding {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    
     {% liquid
      assign slider_navigation_top_place = false
      if slider_enable and section.settings.navigation_position == 'top'
        assign slider_navigation_top_place = true
      endif
    %}
      {%- if slider_navigation_top_place -%}
        <div class="slider__heading--wrapper d-flex align-items-end mb-50">
      {% endif %}

      {% if section.settings.heading != blank or section.settings.subtitle != blank %}
        <div class="section-heading text-{{ section.settings.alignment }} mobile-text-{{ section.settings.mobile_alignment }} {% if slider_enable and section.settings.navigation_position == "top" %} flex-grow-1 {% else %} mb-50 {% endif %}">
          <h2 class="section-heading__title {{ section.settings.heading_size }} rte">
            {{- section.settings.heading | replace: 'p>', 'span>' -}}
          </h2>
          <span class="section-heading__sub_title">{{- section.settings.subtitle -}}</span>
        </div>
      {% endif %}

      {%- if slider_navigation_top_place -%}
        <div
          class="collection__list--slider slider--controls--button d-flex align-items-center"
          id="section__{{ section.id }}"
        >
          {%- if show_navigation -%}
            <div class="swiper-button-prev product__slider--button navigation--icon-{{ section.settings.navigation_icon_style }}  button--{{ section.settings.navigation_button_style }}">
              {% if section.settings.navigation_icon_style == 'chevron' %}
              {% render 'slider-left-arrow-icon' %}
              {% elsif section.settings.navigation_icon_style == 'small_arrow' %}
                {% render 'slider-arrow-icons', icon: 'left' %}
              {% else %}
                {% render 'slider-long-arrow-icons', icon: 'left' %}
              {% endif %}
            </div>
          {%- endif -%}
          {%- if show_pagination and section.settings.pagination_type != 'progress-bar' -%}
            <div class="swiper-pagination product__slider--pagination"></div>
          {%- endif -%}
          {%- if show_navigation -%}
            <div class="swiper-button-next product__slider--button navigation--icon-{{ section.settings.navigation_icon_style }}  button--{{ section.settings.navigation_button_style }}">
              {% if section.settings.navigation_icon_style == 'chevron' %}
                {% render 'slider-right-arrow-icon' %}
              {% elsif section.settings.navigation_icon_style == 'small_arrow' %}
                {% render 'slider-arrow-icons', icon: 'right' %}
              {% else %}
                {% render 'slider-long-arrow-icons', icon: 'right' %}
              {% endif %}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if slider_navigation_top_place -%}
        </div>
      {% endif %}

      <div class="relative product_slider_wrapper" {% if section.settings.image_round_corner %} style="--rounded-image: {{ section.settings.corner_radius }}px;"{% endif %}>
        <div
          class="{{ product_wrapper }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          role="list"
          {% unless slider_enable %}
            grid-recommendation
          {% endunless %}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if slider_enable -%}<div class="swiper-wrapper" grid-recommendation>{%- endif -%}
          {% for recommendation in recommendations.products %}
            <div
              class="{{ product_item }} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% render 'product-card-item',
                card_settings: section.settings,
                product_card_product: recommendation,
                media_size: section.settings.image_ratio,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_badge: section.settings.show_badges,
                badge_position: section.settings.badge_position,
                show_cart_button: section.settings.show_cart_button,
                cart_button_style: section.settings.cart_button_style,
                cart_button_place: section.settings.cart_button_positon,
                show_countdown: section.settings.show_countdown,
                show_countdown_on_image: section.settings.place_timer_on_image,
                show_title: section.settings.show_title,
                show_price: section.settings.show_price,
                show_rating: section.settings.show_product_rating,
                round_image: section.settings.image_round_corner,
                color_swatches: section.settings.color_swatches,
                section_id: section.id
              %}
            </div>
          {% endfor %}
          {%- if slider_enable -%}</div>{%- endif -%}
        </div>

        {% liquid
          assign navigation_bottom_place = false
          if section.settings.navigation_position == 'middle' or section.settings.navigation_position == 'bottom'
            if show_navigation
              assign navigation_bottom_place = true
            endif
          endif

          assign navigation_div = false
          if show_navigation or show_pagination
            assign navigation_div = true
          endif

          if show_pagination and show_navigation == false
            assign navigation_bottom_place = true
          endif

          assign is_not_pagination_progressbar = false
          assign is_pagination_progressbar = false
          if show_pagination and section.settings.pagination_type != 'progress-bar'
            assign is_not_pagination_progressbar = true
          elsif show_pagination and section.settings.pagination_type == 'progress-bar'
            assign is_pagination_progressbar = true
          endif

          assign is_nav_with_progresbar = false
          if show_navigation and section.settings.navigation_position == 'bottom'
            assign is_nav_with_progresbar = true
          endif

          assign is_nav_with_progressbar_design = false
          if is_pagination_progressbar and is_nav_with_progresbar
            assign is_nav_with_progressbar_design = true
          endif
        %}  

        {%- if slider_enable and navigation_div and navigation_bottom_place -%}
          <div
            class="
             collection__list--slider slider--controls--button
             {% if section.settings.navigation_position == 'middle' %}slider--navgaition-button-absolute{% endif %}
             {% if navigation_div or is_not_pagination_progressbar %} slideshow-controls-bottom-margin{% endif %}
            {% if show_navigation and section.settings.navigation_position == 'bottom' %}d-flex align-items-center justify-content-center  {% if show_pagination and is_nav_with_progressbar_design == false %}slider--pagination-width-auto{% endif %}{% endif %}
          "
            id="section__{{ section.id }}"
            {% if section.settings.navigation_button_style == 'round' %}
              style="--slider-button-radius: {{ section.settings.slider_button_radius }}%;"
            {% endif %}
          >
            {%- if show_navigation -%}
              <div class="swiper-button-prev product__slider--button navigation--icon-{{ section.settings.navigation_icon_style }} button--{{ section.settings.navigation_button_style }}">
                {% if section.settings.navigation_icon_style == 'chevron' %}
                  {% render 'slider-left-arrow-icon' %}
                {% elsif section.settings.navigation_icon_style == 'small_arrow' %}
                  {% render 'slider-arrow-icons', icon: 'left' %}
                {% else %}
                  {% render 'slider-long-arrow-icons', icon: 'left' %}
                {% endif %}
              </div>
            {%- endif -%}

            {%- if is_not_pagination_progressbar or is_nav_with_progressbar_design -%}
              <div
                class="swiper-pagination product__slider--pagination {% if is_nav_with_progressbar_design %}nav-button-with-progressbar pagination--progressbar{% endif %}"
              ></div>
            {%- endif -%}

            {%- if show_navigation -%}
              <div class="swiper-button-next product__slider--button navigation--icon-{{ section.settings.navigation_icon_style }}  button--{{ section.settings.navigation_button_style }}">
                  {% if section.settings.navigation_icon_style == 'chevron' %}
                    {% render 'slider-right-arrow-icon' %}
                  {% elsif section.settings.navigation_icon_style == 'small_arrow' %}
                    {% render 'slider-arrow-icons', icon: 'right' %}
                  {% else %}
                    {% render 'slider-long-arrow-icons', icon: 'right' %}
                  {% endif %}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- if is_pagination_progressbar and is_nav_with_progressbar_design == false -%}
        <div class="swiper-pagination product__slider--pagination pagination--progressbar"></div>
      {%- endif -%}
    </div>
  </product-recommendations>
</div>

