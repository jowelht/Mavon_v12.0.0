<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'section-rich-text.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'section-rich-text.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.mobile_padding_top }}px;
    padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --padding-top: {{ section.settings.mobile_padding_top }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      --padding-top: {{ section.settings.padding_top }}px;
    }
  }

  #MainContent > :first-child .section--top-space-{{ section.id }} {
    padding-top: calc(var(--header-height) * var(--transparent-header-show) + var(--padding-top));
  }
{%- endstyle -%}

{% liquid
  assign desktop_alignment = section.settings.alignment

  case desktop_alignment
    when  'left'
      assign desktop_alignment_style = 'flex-start'
    when 'right'
      assign desktop_alignment_style = 'flex-end'
    else
      assign desktop_alignment_style = 'center'
  endcase
%}
{% liquid  
  assign rich_text = section.blocks | where: 'type', 'text'
%}
{% for block in rich_text %}
  {% if block.settings.reveal_text_animation %}
  {{ 'reveal-text-animation.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'reveal-text-animation.js' | asset_url }}" defer="defer"></script>
  {% endif %}
{% endfor %}

<div class="rich-text section--top-space-{{ section.id }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="container">
    <div class="rich-text__blocks {% if section.settings.full_width %}rich-text-full-width{% endif %} text-{{ section.settings.alignment }} mobile-text-{{ section.settings.mobile_alignment }}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'heading' -%}
            <h2
              class="{{ block.settings.heading_size }} gradient--title {% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {{-
                block.settings.heading
                | replace: 'p>', 'span>'
                | replace: 'h1>', 'span>'
                | replace: 'h3>', 'span>'
                | replace: 'h4>', 'span>'
                | replace: 'h5>', 'span>'
                | replace: 'h6>', 'span>'
              -}}
            </h2>
          {%- when 'text' -%}
            <div
              class="rich-text__text gradient--title rte rich-text__{{ block.settings.text_size }} richt_text--{{ block.settings.text_color }} {% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% if block.settings.reveal_text_animation %}
              <text-layered>
                <div
                  class="text_layer__content mb-0 {{ block.settings.text_layer__size }}"
                  style="--layered-alignment: {{ desktop_alignment_style }}"
                >
                  {{ block.settings.text_layer  }}
                </div>
              </text-layered>
              {% else %}
                {{ block.settings.text  }}
              {% endif %}              
            </div>
          {%- when 'button' -%}
            {% liquid
              if block.settings.button_style == 'primary'
                assign button_class = ''
              else
                assign button_class = 'button--secondary'
              endif
            %}

            <a
              {% if block.settings.button_link == blank %}
                aria-disabled="true"
              {% else %}
                href="{{ block.settings.button_link }}"
              {% endif %}
              class="button button--{{ block.settings.button_size }} {{ button_class }} {% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {{ block.settings.button_label | escape }}
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.rich-text.name",
  "tag": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Make section full width",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Desktop content alignment"
    },
    {
      "type": "select",
      "id": "mobile_alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center",
      "label": "Mobile content alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "background-1",
      "label": "t:sections.rich-text.settings.color_scheme.label"
     },
	    {
          "type": "header",
          "content": "Section padding"
        },
		    {
          "type": "paragraph",
          "content": "Desktop"
        },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 150,
          "step": 5,
          "unit": "px",
          "label": "Padding top",
          "default": 50
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 150,
          "step": 5,
          "unit": "px",
          "label": "Padding bottom",
          "default": 50
        },
		  {
          "type": "paragraph",
          "content": "Mobile"
        },
		    {
          "type": "range",
          "id": "mobile_padding_top",
          "min": 0,
          "max": 150,
          "step": 5,
          "unit": "px",
          "label": "Padding top",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_padding_bottom",
          "min": 0,
          "max": 150,
          "step": 5,
          "unit": "px",
          "label": "Padding bottom",
          "default": 50
        }
  ],
  "blocks": [
    {
      "type": "heading",
      "name": "t:sections.rich-text.blocks.heading.name",
      "limit": 1,
      "settings": [
         {
          "type": "richtext",
          "id": "heading",
          "default": "<p>Talk about your brand</p>",
          "label": "t:sections.rich-text.blocks.heading.settings.heading.label",
           "info": "Use bold style to highlight text."
        },
        {
          "type": "select",
          "id": "heading_size",
          "options": [
            {
              "value": "hxl",
              "label": "t:sections.all.heading_size.options__hxl.label"
            },
            {
              "value": "h0",
              "label": "t:sections.all.heading_size.options__h0.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.heading_size.options__h1.label"
            },
            {
              "value": "h2",
              "label": "t:sections.all.heading_size.options__h2.label"
            }
          ],
          "default": "h1",
          "label": "t:sections.all.heading_size.label"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.rich-text.blocks.text.name",
      "limit": 1,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.</p>",
          "label": "t:sections.rich-text.blocks.text.settings.text.label",
          "info": "Use bold style to highlight text.",
          "visible_if": "{{ block.settings.reveal_text_animation == false }}"
        },
        {
          "type": "checkbox",
          "id": "reveal_text_animation",
          "label": "Enable text animation",
          "default": false
        },
        {
          "type": "textarea",
          "id": "text_layer",
          "default": "Share information about your brand with your customers. Describe a product, make announcements, or welcome customers to your store.",
          "label": "Text",
          "visible_if": "{{ block.settings.reveal_text_animation == true }}"
        },
        {
          "type": "select",
          "id": "text_size",
          "options": [
            {
              "value": "extra-large-2",
              "label": "Extra Extra large"
            },
            {
              "value": "extra-large",
              "label": "Extra large"
            },
            {
              "value": "large",
              "label": "Large"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "small",
              "label": "Small"
            }
          ],
          "default": "small",
          "label": "Text size"
        },
        {
          "type": "select",
          "id": "text_color",
          "options": [
            {
              "value": "body",
              "label": "Body"
            },
            {
              "value": "heading",
              "label": "Heading"
            }
          ],
          "default": "body",
          "label": "Text color"
        }
      ]
    },
    {
      "type": "button",
      "name": "t:sections.rich-text.blocks.button.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "button_label",
          "default": "Button label",
          "label": "t:sections.rich-text.blocks.button.settings.button_label.label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:sections.rich-text.blocks.button.settings.button_link.label"
        },
		{
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "primary",
          "options": [
            {
              "value": "secondary",
              "label": "Secondary"
            },
            {
              "value": "primary",
              "label": "Primary"
            }
          ]
        },
        {
          "type": "select",
          "id": "button_size",
          "label": "Button size",
          "default": "large",
          "options": [
          {
            "value": "large",
            "label": "Large"
          },
          {
            "value": "medium",
            "label": "Medium"
          },
          {
            "value": "small",
            "label": "Small"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.rich-text.presets.name",
      "category": "Text",
      "blocks": [
        {
          "type": "heading"
        },
        {
          "type": "text"
        },
        {
          "type": "button"
        }
      ]
    }
  ]
}
{% endschema %}
