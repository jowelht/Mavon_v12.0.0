{% comment %}
  Product card color swatches — supports three modes:
  - "native"  → Uses Shopify's built-in value.swatch data (color or image)
  - "image"   → Uses the variant's featured image as swatch background
  - "color"   → Uses custom colors defined in the Color Swatches section (via data-color attribute)

  Accepts:
  - product: {Object} product object
  - current_variant: {Object} currently selected variant
{% endcomment %}

{%- liquid
  assign color_variant_max_size = settings.max_swatches_show
  assign swatch_type = settings.color_swatch_type
  assign choose_option = settings.color_swatch_activation | downcase

  assign product_content_align = 'justify-content-start'
  if settings.product_content_alignment == 'center'
    assign product_content_align = 'justify-content-center'
  elsif settings.product_content_alignment == 'right'
    assign product_content_align = 'justify-content-end'
  endif
-%}

{%- for option in product.options_with_values -%}
  {%- liquid
    assign option_name = option.name | downcase
  -%}
  {%- if option_name == choose_option -%}
    {%- liquid
      assign color_option_position = 'option' | append: option.position

      if swatch_type == 'native'
        assign swatch_count = option.values | map: 'swatch' | compact | size
        if swatch_count == 0
          break
        endif
      endif
    -%}

    <div class="no-js-hidden product--color-swatch-wrapper {{ product_content_align }}">
      {%- assign number = 0 -%}
      {%- for value in option.values -%}
        {%- assign number = number | plus: 1 -%}

        {%- if number <= color_variant_max_size -%}
          {%- liquid
            assign matched_variant = nil
            for v in product.variants
              assign variant_option_value = v[color_option_position]
              if variant_option_value == value
                assign matched_variant = v
                break
              endif
            endfor

            assign variant_id = matched_variant.id | default: ''

            assign swatch_style = ''
            assign swatch_extra_class = ''

            if swatch_type == 'native'
              if value.swatch.image
                assign native_image_url = value.swatch.image | image_url: width: 50
                assign swatch_style = '--swatch-background-image: url(' | append: native_image_url | append: ');'
                if value.swatch.image.presentation.focal_point
                  assign swatch_style = swatch_style | append: ' --swatch-focal-point: ' | append: value.swatch.image.presentation.focal_point | append: ';'
                endif
              elsif value.swatch.color
                assign swatch_style = '--swatch-background-color: rgb(' | append: value.swatch.color.rgb | append: ');'
              endif

            elsif swatch_type == 'image'
              if matched_variant and matched_variant.featured_image
                assign variant_image_url = matched_variant.featured_image | image_url: width: 50
                assign swatch_style = '--swatch-background-image: url(' | append: variant_image_url | append: ');'
              endif
              assign swatch_extra_class = ' product--color-swatch-image'

            endif

            assign color_item_name = value | escape | downcase
            assign color_item_name_join = color_item_name | split: ' '
            assign color_data_attr = color_item_name_join | join: '-'
          -%}

          <color-swatch-variant
            class="product--color-swatch{{ swatch_extra_class }}"
            data-product-handle="{{ product.handle }}"
            data-variant-id="{{ variant_id }}"
            title="{{ value | escape }}"
            data-value="{{ value | escape }}"
            {% if swatch_type != 'native' %}data-color="{{ color_data_attr }}"{% endif %}
            {% if swatch_style != '' %}style="{{ swatch_style }}"{% endif %}
          >
            <span class="variant--swatch-custom variant--swatch-color">
              <span class="swatch--variant-tooltip">{{- value -}}</span>
            </span>
          </color-swatch-variant>
        {%- endif -%}
      {%- endfor -%}

      {%- if number > color_variant_max_size -%}
        <a class="rest__of--color-variants" href="{{ product.url }}">+{{ number | minus: color_variant_max_size }}</a>
      {%- endif -%}
    </div>

    {%- break -%}
  {%- endif -%}
{%- endfor -%}
