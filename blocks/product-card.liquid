{% stylesheet %}
  .product-card-block {
    min-width: 0;
    max-width: 100%;
    width: var(--pc-block-width, fit-content);
    padding-top: var(--pc-block-padding-top, 0);
    padding-bottom: var(--pc-block-padding-bottom, 0);
    padding-left: var(--pc-block-padding-left, 0);
    padding-right: var(--pc-block-padding-right, 0);
  }

  .product-card-block--bordered {
    border: var(--pc-block-border-thickness, 1px) solid rgba(var(--color-foreground), var(--pc-block-border-opacity, 0.12));
    border-radius: var(--pc-block-corner-radius, 0);
    overflow: hidden;
  }

  .product-card-block:not(.product-card-block--bordered) {
    border-radius: var(--pc-block-corner-radius, 0);
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .product-card-block {
      width: var(--pc-block-width-mobile, var(--pc-block-width, fit-content));
      padding-top: calc(var(--pc-block-padding-top, 0) * var(--pc-block-mobile-scale, 0.8));
      padding-bottom: calc(var(--pc-block-padding-bottom, 0) * var(--pc-block-mobile-scale, 0.8));
      padding-left: calc(var(--pc-block-padding-left, 0) * var(--pc-block-mobile-scale, 0.8));
      padding-right: calc(var(--pc-block-padding-right, 0) * var(--pc-block-mobile-scale, 0.8));
    }
  }
{% endstylesheet %}

{{ 'product-card-item.css' | asset_url | stylesheet_tag }}
{{ 'component-rating.css' | asset_url | stylesheet_tag }}
{{ 'countdown-timer.css' | asset_url | stylesheet_tag }}
<link rel="stylesheet" href="{{ 'component-price.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'component-price.css' | asset_url | stylesheet_tag }}</noscript>
{{ 'quick-add.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product = block.settings.product

  # Width
  case block.settings.width
    when 'fill'
      assign width_value = '100%'
    when 'custom'
      assign width_value = block.settings.width_custom | append: '%'
    else
      assign width_value = 'fit-content'
  endcase

  case block.settings.width_mobile
    when 'fill'
      assign width_mobile_value = '100%'
    when 'custom'
      assign width_mobile_value = block.settings.width_mobile_custom | append: '%'
    else
      assign width_mobile_value = 'fit-content'
  endcase

  # Calculate card_sizes for responsive image loading
  case block.settings.width
    when 'fill'
      assign card_sizes = '100vw'
    when 'custom'
      assign card_sizes = '(min-width: 750px) ' | append: block.settings.width_custom | append: 'vw, 100vw'
    else
      assign card_sizes = '(min-width: 750px) 50vw, 100vw'
  endcase
-%}

<div
  class="product-card-block{% if block.settings.border_style == 'solid' %} product-card-block--bordered{% endif %}"
  style="
    --pc-block-width: {{ width_value }};
    --pc-block-width-mobile: {{ width_mobile_value }};
    --pc-block-border-thickness: {{ block.settings.border_thickness }}px;
    --pc-block-border-opacity: {{ block.settings.border_opacity | divided_by: 100.0 }};
    --pc-block-corner-radius: {{ block.settings.corner_radius }}px;
    --pc-block-padding-top: {{ block.settings.padding_top }}px;
    --pc-block-padding-bottom: {{ block.settings.padding_bottom }}px;
    --pc-block-padding-left: {{ block.settings.padding_left }}px;
    --pc-block-padding-right: {{ block.settings.padding_right }}px;
    --pc-block-mobile-scale: {{ block.settings.mobile_scale | divided_by: 100.0 }};
  "
  {{ block.shopify_attributes }}
>
  <div class="product_slider_wrapper"
    {%- if block.settings.image_round_corner %} style="--rounded-image: {{ block.settings.image_corner_radius }}px;"{% endif %}
  >
    {%- if product != blank -%}
      {% render 'product-card-item',
        card_settings: block.settings,
        card_sizes: card_sizes,
        product_card_product: product,
        media_size: block.settings.image_ratio,
        show_secondary_image: block.settings.show_secondary_image,
        show_vendor: block.settings.show_vendor,
        show_badge: block.settings.show_badges,
        badge_position: block.settings.badge_position,
        show_cart_button: block.settings.show_cart_button,
        cart_button_style: block.settings.cart_button_style,
        cart_button_place: block.settings.cart_button_positon,
        show_countdown: block.settings.show_countdown,
        show_countdown_on_image: block.settings.place_timer_on_image,
        show_title: block.settings.show_title,
        show_price: block.settings.show_price,
        show_rating: block.settings.show_product_rating,
        round_image: block.settings.image_round_corner,
        color_swatches: block.settings.color_swatches,
        section_id: block.id
      %}
    {%- else -%}
      {%- render 'product-card-placeholder',
        product_card_placeholder: 'product-apparel-1',
        round_image: block.settings.image_round_corner,
        media_size: block.settings.image_ratio,
        show_title: block.settings.show_title,
        show_price: block.settings.show_price
      -%}
    {%- endif -%}
  </div>
</div>

