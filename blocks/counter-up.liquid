{% stylesheet %}
  counter-up {
    display: block;
    text-align: var(--counter-up-text-align, center);
  }
  .counter-up__number {
    display: flex;
    align-items: baseline;
    justify-content: var(--counter-up-align, center);
  }
  .counter-up__prefix,
  .counter-up__suffix {
    flex-shrink: 0;
  }
  .counter-up__value {
    display: inline-flex;
    vertical-align: baseline;
  }
  .counter__group {
    display: inline-block;
    height: 1lh;
    overflow: clip;
    line-height: inherit;
  }
  .counter__track {
    display: flex;
    flex-direction: column;
    transition: transform var(--counter-duration, 2000ms) cubic-bezier(0.16, 1, 0.3, 1);
    transition-delay: var(--counter-duration-offset, 0ms);
  }
  .counter__digit {
    line-height: inherit;
  }
  .counter__char {
    display: inline-block;
  }
  counter-up.is-playing .counter__track {
    transform: translateY(calc(-1lh * var(--counter-steps)));
  }
  .counter-up__heading {
    margin-top: 0.8rem;
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    counter-up {
      text-align: var(--counter-up-text-align-mobile, var(--counter-up-text-align, center));
    }
    .counter-up__number {
      justify-content: var(--counter-up-align-mobile, var(--counter-up-align, center));
    }
  }
{% endstylesheet %}

<script src="{{ 'counter-up.js' | asset_url }}" defer></script>

{%- liquid
  assign number = block.settings.number | default: 0
  assign prefix = block.settings.prefix
  assign suffix = block.settings.suffix
  assign heading = block.settings.heading
  assign duration = block.settings.duration

  # Number typography
  assign preset = block.settings.type_preset
  assign number_class = preset
  if preset == 'custom'
    assign number_class = 'custom-typography'
  endif

  # Heading typography
  assign heading_preset = block.settings.heading_preset
  assign heading_class = heading_preset
  if heading_preset == 'custom'
    assign heading_class = 'custom-typography'
  endif
-%}

{%- capture number_style -%}
  {%- if preset == 'custom' -%}
    {%- render 'custom-typography-vars', settings: block.settings -%}
  {%- endif -%}
{%- endcapture -%}

{%- capture heading_style -%}
  {%- if heading_preset == 'custom' -%}
    {%- render 'custom-typography-vars',
      settings: block.settings,
      font: block.settings.heading_font,
      font_size: block.settings.heading_font_size,
      line_height: block.settings.heading_line_height,
      letter_spacing: block.settings.heading_letter_spacing
    -%}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign alignment = block.settings.alignment
  case alignment
    when 'flex-start'
      assign text_align = 'left'
    when 'flex-end'
      assign text_align = 'right'
    else
      assign text_align = 'center'
  endcase

  assign alignment_mobile = block.settings.alignment_mobile
  case alignment_mobile
    when 'flex-start'
      assign text_align_mobile = 'left'
    when 'flex-end'
      assign text_align_mobile = 'right'
    else
      assign text_align_mobile = 'center'
  endcase
-%}

<counter-up
  data-target="{{ number }}"
  data-duration="{{ duration }}"
  style="--counter-up-align: {{ alignment }}; --counter-up-text-align: {{ text_align }}; --counter-up-align-mobile: {{ alignment_mobile }}; --counter-up-text-align-mobile: {{ text_align_mobile }};"
  {{ block.shopify_attributes }}
>
  <div
    class="counter-up__number {{ number_class }}"
    {% if number_style != blank %}style="{{ number_style }}"{% endif %}
  >
    {%- if prefix != blank -%}
      <span class="counter-up__prefix">{{ prefix }}</span>
    {%- endif -%}
    <span class="counter-up__value">0</span>
    {%- if suffix != blank -%}
      <span class="counter-up__suffix">{{ suffix }}</span>
    {%- endif -%}
  </div>
  {%- if heading != blank -%}
    <p
      class="counter-up__heading {{ heading_class }}"
      {% if heading_style != blank %}style="{{ heading_style }}"{% endif %}
    >
      {{ heading }}
    </p>
  {%- endif -%}
</counter-up>

